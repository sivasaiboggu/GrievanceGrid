# ==============================================================================
# GrievanceGrid - Git Ignore Rules
# ==============================================================================

# Operating System
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# IDE & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Python & Testing
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.venv/
env/
venv/
ENV/

# Database Files
*.db
*.sqlite
*.sqlite3
test_grievancegrid.db

# Evidence Uploads (keep directory via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Web Client (Vite / Next.js)
client/dist/
client/.next/
client/out/
client/build/

# Mobile / Expo / React Native
mobile/.expo/
mobile/.expo-shared/
mobile/web-build/
mobile/.expo/dev/logs/

# Android Native Builds & Intermediate Artifacts
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/.cxx/
mobile/android/app/.cxx/
mobile/android/local.properties
*.apk
*.aab
*.keystore
*.jks

# Temporary Logs
*.log
