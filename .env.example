# ==============================================================================
# GrievanceGrid - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to source control.

# Database Configuration (PostgreSQL + PostGIS + pgvector)
DATABASE_URL=postgresql://grievancegrid:your_db_password@localhost:5432/grievancegrid
POSTGRES_USER=grievancegrid
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=grievancegrid
POSTGRES_PORT=5432

# Application Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Redis & Celery Background Processing
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage for Verified Grievance Evidence (S3 Compatible)
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET_NAME=grievancegrid-evidence-vault
S3_REGION=ap-south-1

# Mobile Development Configuration (React Native / Expo)
# For physical Android phone testing, set this to your host computer's local Wi-Fi IP:
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api
EXPO_PUBLIC_API_HOST=localhost
